    "css-loader": "^7.1.2",
    "gh-pages": "^6.3.0",
    "html-webpack-plugin": "^5.6.4",
    "json-loader": "^0.5.7",
    "nodemon": "^3.1.10",
    "style-loader": "^4.0.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-geocoder": "^1.9.4",
    "bootstrap": "^5.3.7",
    "chart.js": "^4.5.0",
    "d3": "^7.9.0",
    "maplibre-gl": "^5.7.0"
  }
